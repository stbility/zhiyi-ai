# 智一 AI™ — 环境变量模板
#
# 本文件只列真实存在的变量,不含任何占位密钥或臆造的变量名。
#
# 生产环境:由 Vercel 的 Supabase / Stripe 集成自动注入,无需手动配置。
# 本地开发:执行 `vercel env pull` 拉取,或复制本文件为 .env.local 手工填写。
#
# 规则:
#   - 留空 = 该能力显示「未配置」。这是合法状态,应用仍可构建和启动。
#   - 填错格式 = 启动时报配置错误,不会静默降级。
#   - 未加 NEXT_PUBLIC_ 前缀的变量仅在服务端读取,不会进入浏览器产物。
#
# 注意:AI Provider 的 API 密钥不在这里配置。
# 密钥与模型在产品内「设置 → 模型服务」页面添加,加密存于数据库,支持测试、轮换、撤销。

# ---------------------------------------------------------------------------
# Supabase
#
# 兼容两套官方命名,填任意一套即可,代码会自动识别:
#   新命名(Supabase 现行文档):PUBLISHABLE_KEY / SECRET_KEY
#   旧命名(Vercel 集成历史生成):ANON_KEY / SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# 可公开的客户端密钥 —— 二选一
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端密钥,绕过 RLS,严禁下发到浏览器 —— 二选一
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 直连 Postgres 连接串,仅用于跑迁移
# Supabase 控制台 → Project Settings → Database → Connection string
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# 应用加密密钥
#
# 用于加密存库的第三方 API Key。未配置时,产品内无法添加模型服务密钥。
# 生成:openssl rand -base64 32
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook 签名密钥。
#   本地:stripe listen --forward-to localhost:3000/api/billing/webhook
#         (路径是 /api/billing/webhook,不是 /api/stripe/webhook ——
#          此处此前写错,照抄会导致本地事件永远送不到)
#   线上:Stripe Dashboard → Developers → Webhooks → 选中该 endpoint
#         → Signing secret → 复制 whsec_ 开头的值
#         endpoint 地址填 https://<你的域名>/api/billing/webhook
#         需要订阅的事件:checkout.session.completed
#                        customer.subscription.created
#                        customer.subscription.updated
#                        customer.subscription.deleted
#                        invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 套餐 Price ID(checkout 主路径用)
#
# 变量名规则:STRIPE_PRICE_<CODE>_MONTH / STRIPE_PRICE_<CODE>_YEAR,
# CODE = PRO / PRO_PLUS / TEAM / ENT —— 正向(checkout)与反向(webhook)
# 共用 src/lib/billing/stripe.ts 的 PLAN_ENV_CODE 映射,不要改其中一处。
#
# 2026-08-13(定价 v2)定价:
#   Professional 专业版   HK49/月、HK490/年
#   Professional 进阶版   HK149/月、HK1,490/年
#   Team 团队版           HK499/月、HK4,990/年
#   Enterprise 企业版     HK1,999/月、HK19,990/年(中大型企业)
#
# 获取:Stripe Dashboard → 产品目录 → 点开产品 → 定价 → 「⋯」→ 复制价格 ID
# (price_ 开头;注意右上角 测试/实盘 开关,test 模式 price_ 在 live 密钥下无效)
# 未配 = checkout 如实 503,前端降级 Payment Link(下方变量)。
# 2026-08-13 实际创建的 8 个 Price ID(参考):
#   price_1U4GIkLySKtXMoIYZ0MNnbvl / price_1U4GJRLySKtXMoIYgpts96qh (PRO 月/年)
#   price_1U4GKcLySKtXMoIYrz2I8X4e / price_1U4GLKLySKtXMoIYVH1WZDjf (PRO_PLUS 月/年)
#   price_1U46nfLySKtXMoIYWcgqMSds / price_1U4EkFLySKtXMoIYv2IeCwlL (TEAM 月/年)
#   price_1U46pxLySKtXMoIYP47HKtHH / price_1U4EmjLySKtXMoIYorylcZUt (ENT 月/年)
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PRO_PLUS_MONTH=
STRIPE_PRICE_PRO_PLUS_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
STRIPE_PRICE_ENT_MONTH=
STRIPE_PRICE_ENT_YEAR=

# ---------------------------------------------------------------------------
# Payment Link(备用收款路径:checkout 不可用时前端降级到这些链接)
#
# 值 = buy.stripe.com 完整 URL(Dashboard → 支付链接 → 对应链接 → 复制)。
# 2026-08-13(定价 v2)完整配置(Pro/Pro+/Team/Ent × 月付/年付,plink ID 见注释):
#   PRO_MONTH      https://buy.stripe.com/7sY5kE84X44b1bs7pY5AQ0x  Professional 月付 HK49   (plink_1U4GSTLySKtXMoIYwKEAlnfM)
#   PRO_YEAR       https://buy.stripe.com/7sY7sMgBt1W3cUaeSq5AQ0y  Professional 年付 HK490  (plink_1U4GUHLySKtXMoIYuShTq0lQ)
#   PRO_PLUS_MONTH https://buy.stripe.com/dRmdRa3OH44b2fwbGe5AQ0z  Professional 进阶版 月付 HK149  (plink_1U4GW0LySKtXMoIYa1zcSfSP)
#   PRO_PLUS_YEAR  https://buy.stripe.com/dRm7sM1GzdEL9HY11A5AQ0A  Professional 进阶版 年付 HK1,490 (plink_1U4GoLLySKtXMoIY9IQhFPC3)
#   TEAM_MONTH     https://buy.stripe.com/7sY6oI3OH0RZ2fwfWu5AQ0B  Team 月付 HK499  (plink_1U4GqvLySKtXMoIYuJGeCC1v)
#   TEAM_YEAR      https://buy.stripe.com/fZuaEYad5bwDaM2bGe5AQ0C  Team 年付 HK4,990 (plink_1U4Gt6LySKtXMoIY8nuWaYmq)
#   ENT_MONTH      https://buy.stripe.com/7sY7sM70T0RZaM211A5AQ0D  Enterprise 月付 HK1,999 (plink_1U4GvWLySKtXMoIYXLmdp0vX)
#   ENT_YEAR       https://buy.stripe.com/00waEYdpheIP6vM25E5AQ0E  Enterprise 年付 HK19,990 (plink_1U4GxmLySKtXMoIYWPdXoQNw)
#   注:2026-08-13(定价 v2)前的旧链接(128/198/388/2888 档)已废弃,勿再使用。
#   webhook 用 PLINK_TO_PLAN(stripe.ts)按 plink ID 兜底判套餐,与这里一一对应。
STRIPE_PAYMENT_LINK_PRO_MONTH=
STRIPE_PAYMENT_LINK_PRO_YEAR=
STRIPE_PAYMENT_LINK_PRO_PLUS_MONTH=
STRIPE_PAYMENT_LINK_PRO_PLUS_YEAR=
STRIPE_PAYMENT_LINK_TEAM_MONTH=
STRIPE_PAYMENT_LINK_TEAM_YEAR=
STRIPE_PAYMENT_LINK_ENT_MONTH=
STRIPE_PAYMENT_LINK_ENT_YEAR=

# 配到哪里:本地写这里;线上写 Vercel → Project → Settings →
# Environment Variables(Production),改完必须 Redeploy 才生效。
#
# 顺带:webhook 判定套餐时优先读 price.metadata.plan_id。建议在
# Dashboard 给价格各加一条 metadata:plan_id = professional / professional_plus /
# team / enterprise —— 那是最稳的一层,不依赖金额也不依赖环境变量。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 安全开关
#
# ALLOW_UNVERIFIED_SIGNUP —— 仅在邮件通道尚未接通、又必须让人能注册时临时开启。
#
# 开启后果:任何人都能用不属于自己的邮箱注册并进入系统,邮箱归属权不再被验证。
# 只认严格的 "true",其它取值一律视为关闭。邮件通道接通后请立即删除该变量。
# ---------------------------------------------------------------------------
ALLOW_UNVERIFIED_SIGNUP=

# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
