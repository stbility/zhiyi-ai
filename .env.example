# 智一 AI™ — 环境变量模板
#
# 本文件只列真实存在的变量,不含任何占位密钥或臆造的变量名。
#
# 生产环境:由 Vercel 的 Supabase / Stripe 集成自动注入,无需手动配置。
# 本地开发:执行 `vercel env pull` 拉取,或复制本文件为 .env.local 手工填写。
#
# 规则:
#   - 留空 = 该能力显示「未配置」。这是合法状态,应用仍可构建和启动。
#   - 填错格式 = 启动时报配置错误,不会静默降级。
#   - 未加 NEXT_PUBLIC_ 前缀的变量仅在服务端读取,不会进入浏览器产物。
#
# 注意:AI Provider 的 API 密钥不在这里配置。
# 密钥与模型在产品内「设置 → 模型服务」页面添加,加密存于数据库,支持测试、轮换、撤销。

# ---------------------------------------------------------------------------
# Supabase
#
# 兼容两套官方命名,填任意一套即可,代码会自动识别:
#   新命名(Supabase 现行文档):PUBLISHABLE_KEY / SECRET_KEY
#   旧命名(Vercel 集成历史生成):ANON_KEY / SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# 可公开的客户端密钥 —— 二选一
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 服务端密钥,绕过 RLS,严禁下发到浏览器 —— 二选一
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 直连 Postgres 连接串,仅用于跑迁移
# Supabase 控制台 → Project Settings → Database → Connection string
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# 应用加密密钥
#
# 用于加密存库的第三方 API Key。未配置时,产品内无法添加模型服务密钥。
# 生成:openssl rand -base64 32
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook 签名密钥。
#   本地:stripe listen --forward-to localhost:3000/api/billing/webhook
#         (路径是 /api/billing/webhook,不是 /api/stripe/webhook ——
#          此处此前写错,照抄会导致本地事件永远送不到)
#   线上:Stripe Dashboard → Developers → Webhooks → 选中该 endpoint
#         → Signing secret → 复制 whsec_ 开头的值
#         endpoint 地址填 https://<你的域名>/api/billing/webhook
#         需要订阅的事件:checkout.session.completed
#                        customer.subscription.created
#                        customer.subscription.updated
#                        customer.subscription.deleted
#                        invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# 套餐 Price ID(四条:Pro/Ent × 月付/年付)
#
# **可以不配** —— 未配时 lib/billing/stripe.ts 的 resolvePriceIdForPlan 会
# 调 stripe.prices.list 从目录自解析(按产品名关键字 professional/专业、
# enterprise/企业,或金额兜底 HKD 4900/49000/22900/229000)。
# 但自解析多一次 API 往返,且改了产品名或金额就会失配 ——
# **生产环境请显式配置**,把「能不能收到钱」从模糊匹配变成确定值。
#
# 获取路径(三选一):
#
#   ① Dashboard(最直观)
#      Stripe Dashboard → 产品目录 Product catalog → 点开对应产品
#      → 定价 Pricing 区块 → 每条价格右侧「⋯」→ 复制价格 ID
#      形如 price_1Qxxxxxxxxxxxxxxxxxxxxxx
#      注意右上角的 测试/实盘 开关:test 模式的 price_ 在 live 密钥下无效
#
#   ② 从已有的 Payment Link 反查(本项目四条链接就是这么建的)
#      Dashboard → 支付链接 Payment links → 点开对应链接
#      → 明细里的产品/价格 → 复制价格 ID
#
#   ③ API(一次列全,推荐)
#      curl -s -u "$STRIPE_SECRET_KEY:" \
#        "https://api.stripe.com/v1/prices?active=true&limit=100&expand[]=data.product" \
#        | jq -r '.data[] | [.id, .unit_amount, .currency, .recurring.interval, .product.name] | @tsv'
#      按「金额 + 周期」对号入座:
#        4900   hkd month → STRIPE_PRICE_PROFESSIONAL
#        49000  hkd year  → STRIPE_PRICE_PROFESSIONAL_YEAR
#        22900  hkd month → STRIPE_PRICE_ENTERPRISE
#        229000 hkd year  → STRIPE_PRICE_ENTERPRISE_YEAR
#
# 配到哪里:本地写这里;线上写 Vercel → Project → Settings →
# Environment Variables(Production),改完必须 Redeploy 才生效。
#
# 顺带:webhook 判定套餐时优先读 price.metadata.plan_id。建议在
# Dashboard 给这四条价格各加一条 metadata:plan_id = professional / enterprise
# —— 那是最稳的一层,不依赖金额也不依赖环境变量。
# ---------------------------------------------------------------------------
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_YEAR=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ENTERPRISE_YEAR=

# ---------------------------------------------------------------------------
# 安全开关
#
# ALLOW_UNVERIFIED_SIGNUP —— 仅在邮件通道尚未接通、又必须让人能注册时临时开启。
#
# 开启后果:任何人都能用不属于自己的邮箱注册并进入系统,邮箱归属权不再被验证。
# 只认严格的 "true",其它取值一律视为关闭。邮件通道接通后请立即删除该变量。
# ---------------------------------------------------------------------------
ALLOW_UNVERIFIED_SIGNUP=

# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
